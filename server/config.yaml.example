# Copy to config.yaml and edit. No values are hardcoded in code.

mongodb:
  # Same MongoDB the agents write directly to -- this server only READS from
  # it for the dashboard, it does not receive heartbeats over HTTP anymore.
  uri: "mongodb://192.168.2.153:27017/"
  database: "amazon_monitoring"

api:
  host: "0.0.0.0"
  port: 8000

auth:
  username: "admin"
  password: "CHANGE_ME_STRONG_PASSWORD"
  jwt_secret: "CHANGE_ME_RANDOM_LONG_STRING"
  jwt_expiry_minutes: 480

heartbeat:
  warning_after_missed_intervals: 2   # -> 60s at 30s heartbeat interval
  offline_after_missed_intervals: 4   # -> 120s at 30s heartbeat interval
  expected_interval_seconds: 30

alerts:
  webhook_url: ""    # optional generic webhook (works for Slack/Teams incoming webhooks)

retention:
  # Raw heartbeats + status_history older than this many days are deleted
  # once every 24h (runs immediately on server startup too). Resolved
  # alerts older than this are also deleted. Unresolved alerts and current
  # live machine/chrome status are NEVER deleted regardless of age.
  days: 1

excel_accounts:
  # Powers the "Available Accounts" dashboard widget -- reads a local .xlsx
  # file, no API/credentials/network needed. Columns, in order: Account
  # name, Phone No, Password, Remarks. Row 1 is treated as a header row.
  enabled: false
  file_path: "available_accounts.xlsx"
  sheet_name: "Sheet1"
  header_rows: 1
  cache_seconds: 86400   # 1 day -- the Refresh button still bypasses this on demand


